---
import Compass from "@/components/icons/Compass.astro";
import Book from "@/components/icons/Book.astro";
import { Image } from "astro:assets";
import heroBackground from "@/assets/hero-background.webp";
import { useTranslations } from "@/i18n/utils";

const lang = (Astro.currentLocale ?? "es") as "es" | "en";
const t = useTranslations(lang);
---

<section
  class="relative isolate flex h-screen flex-col items-center justify-center overflow-hidden text-center"
  aria-labelledby="hero-title"
>
  <Image
    src={heroBackground}
    alt=""
    loading="eager"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />

  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/65"></div>

  <div class="relative z-10 flex flex-col items-center">
    <h1
      id="hero-title"
      class="text-(--color-primary) text-9xl text-center mb-6 text-shadow-[0_0_0.2rem_var(--color-primary)]"
    >
      <span class="block text-white">{t("hero.title.intro")}</span>
      <span class="block">{t("hero.title.name")}</span>
    </h1>

    <p class="text-(--color-text) text-xl w-1/2">
      {t("hero.description")}
    </p>

    <div class="flex text-white gap-8 mt-12">
      <a
        class="flex gap-2 bg-(--color-primary) px-6 py-4 uppercase font-bold tracking-wider font-anton hover:shadow-[0_0rem_1rem_var(--color-primary)] transition-shadow duration-300"
        href=""
      >
        <Compass />
        {t("hero.button-1")}
      </a>

      <a
        class="flex gap-2 bg-(--color-a-secondary) px-6 py-4 uppercase font-bold tracking-wider font-anton border border-white/20 hover:border-white/40 transition-all duration-300"
        href=""
      >
        <Book />
        {t("hero.button-2")}</a
      >
    </div>
  </div>
</section>
