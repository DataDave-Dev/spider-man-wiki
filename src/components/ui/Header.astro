---
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = (Astro.currentLocale ?? "es") as "es" | "en";
const t = useTranslations(lang);
const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);

const navItems = [
  { label: t("header.nav-1"), href: getRelativeLocaleUrl(lang, "/") },
  { label: t("header.nav-2"), href: getRelativeLocaleUrl(lang, "/history") },
  { label: t("header.nav-3"), href: getRelativeLocaleUrl(lang, "/multiverse") },
  { label: t("header.nav-4"), href: getRelativeLocaleUrl(lang, "/characters") },
];
---

<header
  class="absolute z-10 w-full flex items-center justify-between text-(--color-text) p-6 bg-(--color-neutral) border border-white/20 shadow-[0_-2rem_3rem_0_var(--color-primary)]"
>
  <a
    href={getRelativeLocaleUrl(lang, "/")}
    class="font-anton uppercase tracking-wider text-2xl">{t("header.title")}</a
  >
  <nav>
    <ul class="flex gap-4 text-gray-400">
      {
        navItems.map((item) => {
          const isActive = normalizePath(item.href) === currentPath;

          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "nav-link hover:text-(--color-text) transition-colors duration-300",
                  { "is-active text-(--color-text)": isActive },
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="flex gap-4">
    <a
      class="flex gap-2 bg-(--color-a-secondary) text-white px-4 py-2 uppercase font-normal tracking-wider font-anton border border-white/20 hover:border-(--color-primary)/80 transition-all duration-300"
      href={getRelativeLocaleUrl(lang, "#")}>{t("header.button-1")}</a
    >
    <a
      class="flex gap-2 bg-(--color-primary) text-white px-4 py-2 uppercase font-normal tracking-wider font-anton hover:shadow-[0_0rem_1rem_var(--color-primary)] transition-shadow duration-300"
      href={getRelativeLocaleUrl(lang, "#")}>{t("header.button-2")}</a
    >
  </div>
</header>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    background: var(--color-text);
    content: "";
    transform: scaleX(0);
    transition: transform 300ms ease;
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }
</style>
